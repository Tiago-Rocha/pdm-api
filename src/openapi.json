     "text"
    ],
    "properties": {
     "islandId": {
      "type": "string",
      "example": "pico"
     },
     "text": {
      "type": "string",
      "maxLength": 500,
      "example": "Nevoeiro a meio da montanha."
     }
    }
   },
   "EditReport": {
    "type": "object",
